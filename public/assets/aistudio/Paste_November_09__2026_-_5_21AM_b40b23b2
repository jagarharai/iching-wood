/**
 * 呼叫 Gemini API 產生結構化 JSON 解卦報告（含指數退避重試與錯誤捕捉）
 */
export async function fetchGeminiHexagramReading(
  question: string,
  hexagram: Hexagram
): Promise<{ data: AIReadingResult; fromCache: boolean }> {
  const normalizedQ = question.trim();
  const cacheKey = `${SESSION_CACHE_KEY_PREFIX}${hexagram.id}_${normalizedQ}`;

  // 1. 檢查當次工作階段快取 (Session Cache)
  try {
    const cached = sessionStorage.getItem(cacheKey);
    if (cached) {
      const parsed = JSON.parse(cached) as AIReadingResult;
      if (parsed && parsed.coreEssence && Array.isArray(parsed.actionableSteps)) {
        return { data: parsed, fromCache: true };
      }
    }
  } catch {
    // 忽略 sessionStorage 讀取異常
  }

  const { systemPrompt, userQuery } = buildReadingPrompts(normalizedQ, hexagram);
  const apiKey = ''; // 由執行環境自動注入安全憑證
  const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

  const payload = {
    contents: [{ parts: [{ text: userQuery }] }],
    systemInstruction: {
      parts: [{ text: systemPrompt }],
    },
    generationConfig: {
      responseMimeType: 'application/json',
      responseSchema: {
        type: 'OBJECT',
        properties: {
          coreEssence: {
            type: 'STRING',
            description: '① 卦象核心意義：說明此卦的上下卦象徵、時勢結構與主要精神（約 100~150 字）。',
          },
          questionAnalysis: {
            type: 'STRING',
            description: '② 針對問題的解析：緊密結合使用者提問，指出此卦象提供哪些思考角度與處境洞察（約 150~220 字）。',
          },
          blindSpots: {
            type: 'STRING',
            description: '③ 值得注意的盲點：指出使用者在此議題上可能忽略的條件、情緒慣性、風險或矛盾（約 100~160 字）。',
          },
          actionableSteps: {
            type: 'ARRAY',
            items: { type: 'STRING' },
            description: '④ 具體行動建議：提出 3 個可實際執行的具體行動方向，每點簡明扼要。',
          },
          oneLineSummary: {
            type: 'STRING',
            description: '⑤ 一句話總結：以簡潔、有啟發性且契合卦意的語句收尾（約 20~40 字）。',
          },
        },
        required: [
          'coreEssence',
          'questionAnalysis',
          'blindSpots',
          'actionableSteps',
          'oneLineSummary',
        ],
        propertyOrdering: [
          'coreEssence',
          'questionAnalysis',
          'blindSpots',
          'actionableSteps',
          'oneLineSummary',
        ],
      },
    },
  };

  const delays = [1000, 2000, 4000];
  let lastError: Error | null = null;

  for (let attempt = 0; attempt <= delays.length; attempt++) {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000);

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });

      clearTimeout(timeoutId);

      if (!response.ok) {
        if (response.status === 429) {
          throw new Error('RATE_LIMIT_EXCEEDED');
        }
        if (response.status === 401 || response.status === 403) {
          throw new Error('API_KEY_INVALID');
        }
        throw new Error(`HTTP_${response.status}`);
      }

      const result = await response.json();
      const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!jsonText) {
        throw new Error('EMPTY_RESPONSE');
      }

      const parsedData = JSON.parse(jsonText) as AIReadingResult;

      // 寫入 Session Cache
      try {
        sessionStorage.setItem(cacheKey, JSON.stringify(parsedData));
      } catch {
        // 忽略寫入失敗
      }

      return { data: parsedData, fromCache: false };
    } catch (err: any) {
      lastError = err;
      if (
        err.message === 'API_KEY_INVALID' ||
        err.name === 'AbortError' ||
        attempt === delays.length
      ) {
        break;
      }
      await new Promise((res) => setTimeout(res, delays[attempt]));
    }
  }

  throw lastError || new Error('UNKNOWN_ERROR');
}

