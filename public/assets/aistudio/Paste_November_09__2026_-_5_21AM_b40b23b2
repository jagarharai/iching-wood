                  <button
                    key={hex.id}
                    type="button"
                    onClick={() => setInspectHexagram(hex)}
                    className="text-left rounded-xl bg-[#141418] border border-[#C8A96E]/20 hover:border-[#C8A96E]/70 p-5 transition-all hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex flex-col justify-between group"
                  >
                    <div>
                      <div className="flex items-center justify-between text-xs text-[#B8B2A6] mb-3">
                        <span className="font-mono text-[#C8A96E]">
                          第 {String(hex.id).padStart(2, '0')} 卦
                        </span>
                        <span>
                          上{hex.upperKey}下{hex.lowerKey}
                        </span>
                      </div>

                      <div className="flex items-center justify-between gap-4 my-2">
                        <div>
                          <h3 className="text-lg font-serif tracking-widest text-[#F4F0EA] group-hover:text-[#E2C992] transition-colors">
                            {hex.name}
                          </h3>
                          <p className="text-xs text-[#B8B2A6]/80 mt-1 line-clamp-1">
                            {hex.judgment}
                          </p>
                        </div>
                        <div className="shrink-0">
                          <HexagramLinesGraphic lines={hex.lines} size="sm" />
                        </div>
                      </div>
                    </div>

                    <div className="mt-4 pt-3 border-t border-[#C8A96E]/10 flex items-center justify-between">
                      <div className="flex flex-wrap gap-1">
                        {hex.keywords.slice(0, 2).map((kw) => (
                          <span
                            key={kw}
                            className="text-[10px] px-2 py-0.5 rounded bg-[#0D0D0F] text-[#D4B886] border border-[#C8A96E]/20"
                          >
                            {kw}
                          </span>
                        ))}
                      </div>
                      <span className="text-[11px] text-[#C8A96E] flex items-center gap-0.5 opacity-75 group-hover:opacity-100">
                        <span>詳情</span>
                        <ChevronRight className="w-3.5 h-3.5" />
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ================================================================
            視圖三：問卜紀錄 (localStorage 管理、重溫與刪除)
           ================================================================ */}
        {activeTab === 'history' && (
          <div className="space-y-6 max-w-4xl mx-auto">
            {/* 標題與隱私儲存聲明 */}
            <div className="rounded-2xl bg-[#141418] border border-[#C8A96E]/25 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div className="space-y-1.5">
                <h2 className="text-2xl font-serif tracking-[0.18em] text-[#F4F0EA]">
                  本機問卜歷史紀錄
                </h2>
                <p className="text-xs text-[#B8B2A6] flex items-center gap-1.5">
                  <Lock className="w-3.5 h-3.5 text-[#C8A96E] shrink-0" />
                  <span>
                    隱私說明：所有紀錄僅儲存在您目前的瀏覽器（localStorage），不會上傳伺服器，亦不會跨裝置同步。
                  </span>
                </p>
              </div>

              {history.length > 0 && (
                <button
                  type="button"
                  onClick={() => setConfirmClearModal(true)}
                  className="px-4 py-2 rounded-xl border border-rose-500/40 bg-rose-950/20 text-rose-300 hover:bg-rose-950/40 text-xs flex items-center gap-1.5 self-start sm:self-auto shrink-0 transition-colors"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  <span>清空全部紀錄</span>
                </button>
              )}
            </div>

            {/* 紀錄清單 */}
            {history.length === 0 ? (
              <div className="rounded-2xl bg-[#141418] border border-[#C8A96E]/20 p-12 text-center space-y-4">
                <History className="w-10 h-10 text-[#C8A96E]/40 mx-auto" />
                <div className="space-y-1">
                  <p className="text-base font-serif text-[#F4F0EA]">目前尚無儲存的問卜紀錄</p>
                  <p className="text-xs text-[#B8B2A6]">
                    在抽卡結果頁點擊「儲存本次結果」，即可將問題、卦象與 AI 解讀保存在此瀏覽器中。
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => setActiveTab('oracle')}
                  className="px-5 py-2.5 rounded-xl bg-[#C8A96E] text-[#0D0D0F] text-xs font-medium tracking-wider"
                >
                  前往問卜抽卡
                </button>
              </div>
            ) : (
              <div className="space-y-4">
                {history.map((item) => {
                  const hex = HEXAGRAMS.find((h) => h.id === item.hexagramId);
                  if (!hex) return null;
                  const dateStr = new Date(item.timestamp).toLocaleString('zh-TW', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                  });

                  return (
                    <div
                      key={item.id}
                      className="rounded-2xl bg-[#141418] border border-[#C8A96E]/25 p-5 sm:p-6 hover:border-[#C8A96E]/50 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
                    >
                      <div className="flex items-start gap-4 flex-1">
                        <div className="p-3 rounded-xl bg-[#0D0D0F] border border-[#C8A96E]/20 shrink-0 hidden sm:block">
                          <HexagramLinesGraphic lines={hex.lines} size="sm" />
                        </div>
                        <div className="space-y-1.5 flex-1">
                          <div className="flex flex-wrap items-center gap-2 text-xs text-[#B8B2A6]">
                            <span className="text-[#C8A96E] font-serif font-medium">
                              第 {hex.id} 卦・{hex.name}
                            </span>
                            <span>｜</span>
                            <span>{dateStr}</span>
                            {item.aiReading && (
                              <span className="px-2 py-0.5 rounded-full bg-[#C8A96E]/15 text-[#E2C992] text-[10px]">
                                含 AI 深度解析
                              </span>
                            )}
                          </div>
                          <h3 className="text-base font-serif text-[#F4F0EA]">
                            「{item.question}」
                          </h3>
                          {item.aiReading?.oneLineSummary ? (
                            <p className="text-xs text-[#D4B886] line-clamp-1">
                              總結：{item.aiReading.oneLineSummary}
                            </p>
                          ) : (
                            <p className="text-xs text-[#B8B2A6]/80 line-clamp-1">
                              {hex.coreMeaning}
                            </p>
                          )}
                        </div>
                      </div>

                      <div className="flex items-center gap-2 w-full sm:w-auto justify-end border-t sm:border-t-0 border-[#C8A96E]/10 pt-3 sm:pt-0">
                        <button
                          type="button"
                          onClick={() => handleLoadHistoryItem(item)}
                          className="px-3.5 py-2 rounded-lg bg-[#C8A96E]/15 border border-[#C8A96E]/40 text-xs text-[#E2C992] hover:bg-[#C8A96E]/25 flex items-center gap-1.5"
                        >
                          <Eye className="w-3.5 h-3.5" />
                          <span>查看完整報告</span>
                        </button>
                        <button
                          type="button"
                          onClick={() => handleDeleteHistoryItem(item.id)}
                          aria-label="刪除此筆紀錄"
                          className="p-2 rounded-lg bg-[#0D0D0F] border border-[#C8A96E]/20 text-[#B8B2A6] hover:text-rose-400 hover:border-rose-500/40 transition-colors"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}
      </main>

      {/* ================================================================
          彈出視窗：圖鑑單卦詳情檢視 Modal
         ================================================================ */}
      {inspectHexagram && (
        <div
          className="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto"
          onClick={() => setInspectHexagram(null)}
        >
          <div
            className="max-w-xl w-full rounded-2xl bg-[#141418] border-2 border-[#C8A96E]/60 p-6 sm:p-8 shadow-2xl space-y-6 relative my-8"
            onClick={(e) => e.stopPropagation()}
          >
            <button
              type="button"
              onClick={() => setInspectHexagram(null)}
              className="absolute top-5 right-5 p-2 rounded-full bg-[#0D0D0F] text-[#B8B2A6] hover:text-[#F4F0EA] border border-[#C8A96E]/30"
            >
              <X className="w-4 h-4" />
            </button>

            <div className="flex flex-col sm:flex-row items-center gap-6 border-b border-[#C8A96E]/20 pb-6">
              <div className="p-4 rounded-xl bg-[#0D0D0F] border border-[#C8A96E]/25">
                <HexagramLinesGraphic
                  lines={inspectHexagram.lines}
                  size="md"
                  showLabels={true}
                />
              </div>
              <div className="text-center sm:text-left space-y-2">
                <span className="text-xs font-mono tracking-widest text-[#C8A96E]">
                  文王卦序 第 {inspectHexagram.id} 卦
                </span>
                <h3 className="text-3xl font-serif tracking-[0.2em] text-[#F4F0EA]">
                  {inspectHexagram.name}
                </h3>
                <p className="text-xs text-[#B8B2A6] tracking-wider">
                  上卦：{inspectHexagram.upperTrigram} ｜ 下卦：{inspectHexagram.lowerTrigram}
                </p>
                <div className="flex flex-wrap justify-center sm:justify-start gap-1.5 pt-1">
                  {inspectHexagram.keywords.map((kw) => (
                    <span
                      key={kw}
                      className="px-2.5 py-0.5 rounded-full bg-[#C8A96E]/15 border border-[#C8A96E]/30 text-xs text-[#E2C992]"
                    >
                      {kw}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div className="space-y-4 text-sm">
              <div>
                <span className="text-xs tracking-widest text-[#C8A96E] block mb-1">
                  【周易本經卦辭】
                </span>
                <p className="text-base font-serif text-[#F4F0EA] bg-[#0D0D0F] p-3.5 rounded-xl border-l-2 border-[#C8A96E]">
                  {inspectHexagram.judgment}
                </p>
              </div>
              <div>
                <span className="text-xs tracking-widest text-[#C8A96E] block mb-1">
                  【象傳・大象】
                </span>
                <p className="text-sm font-serif text-[#E2C992] bg-[#0D0D0F] p-3.5 rounded-xl border-l-2 border-[#C8A96E]/60">
                  {inspectHexagram.imageText}
                </p>
              </div>
              <div>
                <span className="text-xs tracking-widest text-[#C8A96E] block mb-1">
                  【核心卦義與處世啟示】
                </span>
                <p className="text-sm text-[#F4F0EA]/90 leading-relaxed">
                  {inspectHexagram.coreMeaning}
                </p>
              </div>
            </div>

            <div className="pt-2 flex justify-end">
              <button
                type="button"
                onClick={() => setInspectHexagram(null)}
                className="px-5 py-2 rounded-xl bg-[#C8A96E] text-[#0D0D0F] text-xs font-medium tracking-wider"
              >
                關閉視窗
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================================================================
          彈出視窗：清空歷史紀錄確認 Modal (取代原生 confirm)
         ================================================================ */}
      {confirmClearModal && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="max-w-md w-full rounded-2xl bg-[#141418] border border-[#C8A96E]/50 p-6 space-y-5 shadow-2xl">
            <div className="flex items-center gap-3 text-rose-300">
              <AlertCircle className="w-6 h-6 shrink-0" />
              <h3 className="text-lg font-serif tracking-wider">確定要清空全部問卜紀錄嗎？</h3>
            </div>
            <p className="text-xs sm:text-sm text-[#B8B2A6] leading-relaxed">
              此操作將會永久刪除目前儲存在此瀏覽器中的所有問卜歷史與 AI 解卦報告，刪除後無法復原。
            </p>
            <div className="flex items-center justify-end gap-3 pt-2">
              <button
                type="button"
                onClick={() => setConfirmClearModal(false)}
                className="px-4 py-2 rounded-xl border border-[#C8A96E]/30 text-xs text-[#B8B2A6] hover:text-[#F4F0EA]"
              >
                取消
              </button>
              <button
                type="button"
                onClick={handleClearAllHistory}
                className="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-medium"
              >
                確認清空全部
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 底部系統完整性驗證與聲明狀態列 */}
      <footer className="border-t border-[#C8A96E]/15 bg-[#0A0A0C] py-6 px-4 sm:px-6 text-xs text-[#B8B2A6]/70">
        <div className="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
          <div className="flex items-center gap-2">
            <ShieldCheck
              className={`w-4 h-4 ${
                dbValidation.isValid ? 'text-emerald-400' : 'text-amber-400'
              }`}
            />
            <span>
              資料庫完整性驗證：
              {dbValidation.isValid
                ? `已通過（文王 ${dbValidation.totalCount} 卦齊全・${dbValidation.uniqueBinaryCount} 組二進位六爻無重複・卦辭原典已核實）`
                : dbValidation.errors.join(' / ')}
            </span>
          </div>
          <div className="text-[11px] text-[#B8B2A6]/50 text-center sm:text-right">
            易經六十四卦 AI 智慧抽卡・單卦啟發式決策輔助系統（非醫療、法律或投資預測）
          </div>
        </div>
      </footer>
    </div>
  );
}