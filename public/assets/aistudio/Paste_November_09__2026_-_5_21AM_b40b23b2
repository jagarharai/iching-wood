function getLineName(index: number, val: 0 | 1): string {
  const posNames = ['初', '二', '三', '四', '五', '上'];
  const yinYang = val === 1 ? '九' : '六';
  if (index === 0 || index === 5) {
    return `${posNames[index]}${yinYang}（${val === 1 ? '陽爻' : '陰爻'}）`;
  }
  return `${yinYang}${posNames[index]}（${val === 1 ? '陽爻' : '陰爻'}）`;
}

