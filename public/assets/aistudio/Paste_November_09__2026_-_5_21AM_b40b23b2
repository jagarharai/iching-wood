                                  <span>{stepText}</span>
                                </li>
                              ))}
                            </ul>
                          </div>

                          {/* ⑤ 一句話總結 */}
                          <div className="p-5 rounded-xl bg-gradient-to-r from-[#C8A96E]/15 via-[#C8A96E]/10 to-transparent border-l-4 border-[#C8A96E] space-y-1">
                            <span className="text-[11px] tracking-[0.2em] text-[#C8A96E] uppercase block">
                              ⑤ 一句話總結
                            </span>
                            <p className="text-base sm:text-lg font-serif text-[#F4F0EA] tracking-wide">
                              「{aiReading.oneLineSummary}」
                            </p>
                          </div>

                          {/* 免責與理性反思聲明 */}
                          <p className="text-[11px] text-[#B8B2A6]/60 leading-relaxed pt-2">
                            ※ 決策輔助聲明：本報告由 AI 根據《周易》原典與您的提問生成，旨在提供多維度的象徵性反思與盲點檢視，不代表對未來、醫療、法律或投資報酬之確定預測，最終決定權始終在您手中。
                          </p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}

        {/* ================================================================
            視圖二：六十四卦圖鑑 (完整 64 卦瀏覽、搜尋、八卦篩選與詳情)
           ================================================================ */}
        {activeTab === 'compendium' && (
          <div className="space-y-8">
            {/* 圖鑑標題與搜尋篩選列 */}
            <div className="rounded-2xl bg-[#141418] border border-[#C8A96E]/25 p-6 space-y-5">
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <h2 className="text-2xl font-serif tracking-[0.18em] text-[#F4F0EA]">
                    文王六十四卦完整圖鑑
                  </h2>
                  <p className="text-xs sm:text-sm text-[#B8B2A6] mt-1">
                    收錄全部 64 卦標準六爻陰陽、上下經卦組合、《周易》卦辭與《大象傳》原文
                  </p>
                </div>

                {/* 搜尋框 */}
                <div className="relative w-full md:w-72">
                  <Search className="w-4 h-4 text-[#C8A96E] absolute left-3.5 top-1/2 -translate-y-1/2" />
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="搜尋卦序、卦名、關鍵字或卦辭..."
                    className="w-full pl-10 pr-8 py-2.5 rounded-xl bg-[#0D0D0F] border border-[#C8A96E]/30 focus:border-[#C8A96E] focus:outline-none text-xs sm:text-sm text-[#F4F0EA] placeholder-[#B8B2A6]/40"
                  />
                  {searchQuery && (
                    <button
                      type="button"
                      onClick={() => setSearchQuery('')}
                      className="absolute right-2.5 top-1/2 -translate-y-1/2 text-[#B8B2A6] hover:text-[#F4F0EA]"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  )}
                </div>
              </div>

              {/* 上下卦篩選器 */}
              <div className="pt-4 border-t border-[#C8A96E]/15 flex flex-wrap items-center gap-4 text-xs">
                <div className="flex items-center gap-2 flex-wrap">
                  <span className="text-[#C8A96E] tracking-wider">上卦：</span>
                  <button
                    type="button"
                    onClick={() => setFilterUpper('ALL')}
                    className={`px-2.5 py-1 rounded-md transition-colors ${
                      filterUpper === 'ALL'
                        ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium'
                        : 'bg-[#0D0D0F] text-[#B8B2A6] hover:text-[#F4F0EA]'
                    }`}
                  >
                    全部
                  </button>
                  {(Object.keys(TRIGRAMS) as TrigramKey[]).map((k) => (
                    <button
                      key={`up_${k}`}
                      type="button"
                      onClick={() => setFilterUpper(k)}
                      className={`px-2.5 py-1 rounded-md transition-colors ${
                        filterUpper === k
                          ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium'
                          : 'bg-[#0D0D0F] text-[#B8B2A6] hover:text-[#F4F0EA]'
                      }`}
                    >
                      {TRIGRAMS[k].name}
                    </button>
                  ))}
                </div>

                <div className="flex items-center gap-2 flex-wrap">
                  <span className="text-[#C8A96E] tracking-wider">下卦：</span>
                  <button
                    type="button"
                    onClick={() => setFilterLower('ALL')}
                    className={`px-2.5 py-1 rounded-md transition-colors ${
                      filterLower === 'ALL'
                        ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium'
                        : 'bg-[#0D0D0F] text-[#B8B2A6] hover:text-[#F4F0EA]'
                    }`}
                  >
                    全部
                  </button>
                  {(Object.keys(TRIGRAMS) as TrigramKey[]).map((k) => (
                    <button
                      key={`low_${k}`}
                      type="button"
                      onClick={() => setFilterLower(k)}
                      className={`px-2.5 py-1 rounded-md transition-colors ${
                        filterLower === k
                          ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium'
                          : 'bg-[#0D0D0F] text-[#B8B2A6] hover:text-[#F4F0EA]'
                      }`}
                    >
                      {TRIGRAMS[k].name}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            {/* 64 卦網格列表 */}
            {filteredHexagrams.length === 0 ? (
              <div className="rounded-2xl bg-[#141418] border border-[#C8A96E]/20 p-12 text-center space-y-3">
                <p className="text-base text-[#B8B2A6]">找不到符合篩選條件的卦象</p>
                <button
                  type="button"
                  onClick={() => {
                    setSearchQuery('');
                    setFilterUpper('ALL');
                    setFilterLower('ALL');
                  }}
                  className="px-4 py-2 rounded-lg bg-[#C8A96E]/20 text-xs text-[#E2C992] hover:bg-[#C8A96E]/30"
                >
                  重置所有篩選條件
                </button>
              </div>
            ) : (
              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
