      opacity="0.45"
    />
    <circle cx="60" cy="60" r="24" stroke="currentColor" strokeWidth="1" opacity="0.75" />
    <path
      d="M60 36 A12 12 0 0 1 60 60 A12 12 0 0 0 60 84 A24 24 0 0 1 60 36 Z"
      fill="currentColor"
      opacity="0.2"
    />
    <circle cx="60" cy="48" r="3" fill="currentColor" opacity="0.7" />
    <circle cx="60" cy="72" r="3" stroke="currentColor" strokeWidth="1.2" opacity="0.7" />
  </svg>
);

// ============================================================================
// 六、主應用程式元件 (App)
// ============================================================================

type ActiveTab = 'oracle' | 'compendium' | 'history';
type OracleStep = 1 | 2 | 3;

const PRESET_QUESTIONS = [
  '我目前適合創業或開啟這項新專案嗎？',
  '這段合作或重要關係，接下來該如何相處？',
  '面對目前的職涯瓶頸，我應該轉換方向嗎？',
  '近期這項重要決策，我忽略了什麼關鍵盲點？',
];

export default function App() {
  // 導覽分頁狀態
  const [activeTab, setActiveTab] = useState<ActiveTab>('oracle');

  // 資料庫完整性驗證結果
  const dbValidation = useMemo(() => validateHexagramDatabase(HEXAGRAMS), []);

  // 抽卡問卜流程狀態
  const [step, setStep] = useState<OracleStep>(1);
  const [question, setQuestion] = useState<string>('');
  const [questionError, setQuestionError] = useState<string>('');
  const [drawnHexagram, setDrawnHexagram] = useState<Hexagram | null>(null);
  const [isShuffling, setIsShuffling] = useState<boolean>(false);
  const [selectedCardSlot, setSelectedCardSlot] = useState<number | null>(null);
  const [isCardFlipped, setIsCardFlipped] = useState<boolean>(false);

  // AI 解卦狀態
  const [aiReading, setAiReading] = useState<AIReadingResult | null>(null);
  const [isAiLoading, setIsAiLoading] = useState<boolean>(false);
  const [aiError, setAiError] = useState<string | null>(null);
  const [isFromCache, setIsFromCache] = useState<boolean>(false);
  const [lastAiCallTime, setLastAiCallTime] = useState<number>(0);
  const [cooldownSeconds, setCooldownSeconds] = useState<number>(0);

  // 歷史紀錄狀態
  const [history, setHistory] = useState<ReadingHistoryItem[]>([]);
  const [currentRecordId, setCurrentRecordId] = useState<string | null>(null);
  const [confirmClearModal, setConfirmClearModal] = useState<boolean>(false);

  // 六十四卦圖鑑篩選狀態
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [filterUpper, setFilterUpper] = useState<TrigramKey | 'ALL'>('ALL');
  const [filterLower, setFilterLower] = useState<TrigramKey | 'ALL'>('ALL');
  const [inspectHexagram, setInspectHexagram] = useState<Hexagram | null>(null);

  // Toast 通知訊息
  const [toastMsg, setToastMsg] = useState<string | null>(null);
  const aiSectionRef = useRef<HTMLDivElement | null>(null);

  // 載入本機歷史紀錄
  useEffect(() => {
    setHistory(loadHistoryFromStorage());
  }, []);

  // 速率限制倒數計時器
  useEffect(() => {
    if (cooldownSeconds <= 0) return;
    const timer = setInterval(() => {
      setCooldownSeconds((prev) => Math.max(0, prev - 1));
    }, 1000);
    return () => clearInterval(timer);
  }, [cooldownSeconds]);

  const showToast = (msg: string) => {
    setToastMsg(msg);
    setTimeout(() => {
      setToastMsg((prev) => (prev === msg ? null : prev));
    }, 3200);
  };

  // STEP 1 -> STEP 2：確認問題並進入牌陣
  const handleProceedToDraw = (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    const trimmed = question.trim();
    if (!trimmed) {
      setQuestionError('請先靜心輸入您想請益的問題（不可為空白）。');
      return;
    }
    setQuestionError('');
    setDrawnHexagram(null);
    setAiReading(null);
    setAiError(null);
    setIsFromCache(false);
    setSelectedCardSlot(null);
    setIsCardFlipped(false);
    setCurrentRecordId(null);
    setStep(2);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // STEP 2：洗牌動效
  const handleShuffleDeck = () => {
    if (isShuffling || selectedCardSlot !== null) return;
    setIsShuffling(true);
    setTimeout(() => {
      setIsShuffling(false);
    }, 650);
  };

  // STEP 2 -> STEP 3：執行加密級隨機抽卦並觸發翻牌
  const handleDrawCard = (slotIndex?: number) => {
    if (selectedCardSlot !== null) return;
    const chosenSlot =
      slotIndex !== undefined ? slotIndex : getCryptoUniformRandomInt(64);
    setSelectedCardSlot(chosenSlot);

    // 使用 crypto.getRandomValues 獨立等機率抽取一卦
    const hex = drawRandomHexagram();
    setDrawnHexagram(hex);

    setTimeout(() => {
      setStep(3);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        setIsCardFlipped(true);
      }, 120);
    }, 680);
  };

  // STEP 4：手動點擊「深入解卦」呼叫 Gemini AI
  const handleRequestAiReading = async () => {
    if (!drawnHexagram || isAiLoading) return;

    // 先檢查是否已有當次 Session 快取（若有快取則不受冷卻時間限制）
    const cacheKey = `${SESSION_CACHE_KEY_PREFIX}${drawnHexagram.id}_${question.trim()}`;
    const hasCache = Boolean(sessionStorage.getItem(cacheKey));

    const now = Date.now();
    if (!hasCache && now - lastAiCallTime < RATE_LIMIT_COOLDOWN_MS) {
      const remain = Math.ceil((RATE_LIMIT_COOLDOWN_MS - (now - lastAiCallTime)) / 1000);
      setCooldownSeconds(remain);
      showToast(`請求過於頻繁，請稍候 ${remain} 秒再試`);
      return;
    }

    setIsAiLoading(true);
    setAiError(null);

    setTimeout(() => {
      aiSectionRef.current?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 100);

    try {
      const { data, fromCache } = await fetchGeminiHexagramReading(question, drawnHexagram);
      setAiReading(data);
      setIsFromCache(fromCache);
      if (!fromCache) {
        setLastAiCallTime(Date.now());
        setCooldownSeconds(Math.ceil(RATE_LIMIT_COOLDOWN_MS / 1000));
      }

      // 若已儲存過此筆紀錄，同步更新紀錄中的 AI 解讀
      if (currentRecordId) {
        setHistory((prev) => {
          const updated = prev.map((item) =>
            item.id === currentRecordId ? { ...item, aiReading: data } : item
          );
          saveHistoryToStorage(updated);
          return updated;
        });
      }
    } catch (err: any) {
      if (err.message === 'RATE_LIMIT_EXCEEDED') {
        setAiError('目前 AI 解卦服務請求額度已達上限，請稍候片刻再試。您仍可參閱上方的《周易》原典卦辭與基礎卦義進行反思。');
      } else if (err.message === 'API_KEY_INVALID') {
        setAiError('目前環境尚未設定有效的 Gemini API 金鑰，已自動切換為「經典原典離線模式」。您可完整查閱固定卦義與自省提問。');
      } else {
        setAiError('連線至 AI 解卦服務時發生逾時或網路異常，請稍後重試，或直接參考上方經典原典卦義。');
      }
    } finally {
      setIsAiLoading(false);
    }
  };

  // 儲存本次結果至瀏覽器 localStorage
  const handleSaveCurrentReading = () => {
    if (!drawnHexagram) return;

    if (currentRecordId) {
      // 更新既有紀錄
      const updated = history.map((item) =>
        item.id === currentRecordId
          ? { ...item, aiReading: aiReading || item.aiReading }
          : item
      );
      setHistory(updated);
      saveHistoryToStorage(updated);
      showToast('已更新本機問卜紀錄');
      return;
    }

    const newRecord: ReadingHistoryItem = {
      id: `rec_${Date.now()}_${getCryptoUniformRandomInt(10000)}`,
      timestamp: Date.now(),
      question: question.trim(),
      hexagramId: drawnHexagram.id,
      aiReading: aiReading || undefined,
    };

    const nextHistory = [newRecord, ...history];
    setHistory(nextHistory);
    saveHistoryToStorage(nextHistory);
    setCurrentRecordId(newRecord.id);
    showToast('已儲存至本機「問卜紀錄」');
  };

  // 格式化純文字報告（供複製與分享使用）
  const formatReadingShareText = (): string => {
    if (!drawnHexagram) return '';
    const lines = [
      `【易經六十四卦 AI 智慧抽卡】`,
      `提問：「${question.trim()}」`,
      `抽得：第 ${drawnHexagram.id} 卦｜${drawnHexagram.name}（上${drawnHexagram.upperTrigram} / 下${drawnHexagram.lowerTrigram}）`,
      `關鍵字：${drawnHexagram.keywords.join('・')}`,
      `《周易》卦辭：${drawnHexagram.judgment}`,
      `《大象傳》：${drawnHexagram.imageText}`,
      `基礎卦義：${drawnHexagram.coreMeaning}`,
    ];

    if (aiReading) {
      lines.push(
        ``,
        `--- AI 個人化深度解卦 ---`,
        `① 卦象核心意義：${aiReading.coreEssence}`,
        `② 針對問題的解析：${aiReading.questionAnalysis}`,
        `③ 值得注意的盲點：${aiReading.blindSpots}`,
        `④ 具體行動建議：`,
        ...aiReading.actionableSteps.map((s, idx) => `   ${idx + 1}. ${s}`),
        `⑤ 一句話總結：「${aiReading.oneLineSummary}」`
      );
    }

    return lines.join('\n');
  };

  // 複製解卦內容
  const handleCopyReading = async () => {
    const text = formatReadingShareText();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      showToast('已複製完整卦象與解析內容');
    } catch {
      showToast('複製失敗，請手動選取文字複製');
    }
  };

  // 原生分享或降級複製
  const handleShareReading = async () => {
    if (!drawnHexagram) return;
    const text = formatReadingShareText();
    if (navigator.share) {
      try {
        await navigator.share({
          title: `易經六十四卦｜第 ${drawnHexagram.id} 卦 ${drawnHexagram.name}`,
          text,
        });
        return;
      } catch {
        // 使用者取消分享或環境不支援時降級至複製
      }
    }
    await handleCopyReading();
  };

  // 重新抽卡
  const handleResetOracle = () => {
    setStep(1);
    setDrawnHexagram(null);
    setAiReading(null);
    setAiError(null);
    setSelectedCardSlot(null);
    setIsCardFlipped(false);
    setCurrentRecordId(null);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // 從歷史紀錄載入檢視
  const handleLoadHistoryItem = (item: ReadingHistoryItem) => {
    const hex = HEXAGRAMS.find((h) => h.id === item.hexagramId);
    if (!hex) return;
    setQuestion(item.question);
    setDrawnHexagram(hex);
    setAiReading(item.aiReading || null);
    setAiError(null);
    setIsFromCache(true);
    setCurrentRecordId(item.id);
    setStep(3);
    setIsCardFlipped(true);
    setActiveTab('oracle');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // 刪除單筆歷史紀錄
  const handleDeleteHistoryItem = (id: string) => {
    const next = history.filter((item) => item.id !== id);
    setHistory(next);
    saveHistoryToStorage(next);
    if (currentRecordId === id) {
      setCurrentRecordId(null);
    }
    showToast('已刪除該筆問卜紀錄');
  };

  // 清空全部歷史紀錄
  const handleClearAllHistory = () => {
    setHistory([]);
    saveHistoryToStorage([]);
    setCurrentRecordId(null);
    setConfirmClearModal(false);
    showToast('已清空所有本機問卜紀錄');
  };

  // 圖鑑篩選邏輯
  const filteredHexagrams = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return HEXAGRAMS.filter((h) => {
      if (filterUpper !== 'ALL' && h.upperKey !== filterUpper) return false;
      if (filterLower !== 'ALL' && h.lowerKey !== filterLower) return false;
      if (!q) return true;
      return (
        h.name.toLowerCase().includes(q) ||
        h.shortName.toLowerCase().includes(q) ||
        String(h.id) === q ||
        h.keywords.some((k) => k.toLowerCase().includes(q)) ||
        h.judgment.toLowerCase().includes(q)
      );
    });
  }, [searchQuery, filterUpper, filterLower]);

  return (
    <div className="min-h-screen bg-[#0D0D0F] text-[#F4F0EA] flex flex-col font-sans selection:bg-[#C8A96E]/30 selection:text-[#F4F0EA]">
      {/* 頂部古典極簡導覽列 */}
      <header className="sticky top-0 z-30 backdrop-blur-md bg-[#0D0D0F]/85 border-b border-[#C8A96E]/20">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          {/* 品牌標誌 */}
          <button
            onClick={() => {
              setActiveTab('oracle');
            }}
            className="flex items-center gap-3 text-left group focus:outline-none"
          >
            <div className="w-9 h-9 rounded-full border border-[#C8A96E]/50 bg-[#141418] flex items-center justify-center text-[#C8A96E] group-hover:border-[#C8A96E] group-hover:scale-105 transition-all">
              <Compass className="w-4 h-4" />
            </div>
            <div>
              <span className="block text-base sm:text-lg font-serif tracking-[0.15em] text-[#F4F0EA] font-medium">
                易經六十四卦
              </span>
              <span className="block text-[10px] tracking-[0.2em] text-[#C8A96E]/80 uppercase">
                I Ching Oracle Deck
              </span>
            </div>
          </button>

          {/* 三大主視圖切換 */}
          <nav className="flex items-center gap-1 sm:gap-2 bg-[#141418] p-1 rounded-full border border-[#C8A96E]/20">
            <button
              onClick={() => setActiveTab('oracle')}
              className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm tracking-wider transition-all ${
                activeTab === 'oracle'
                  ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium shadow-[0_0_15px_rgba(200,169,110,0.3)]'
                  : 'text-[#B8B2A6] hover:text-[#F4F0EA]'
              }`}
            >
              <Sparkles className="w-3.5 h-3.5" />
              <span>問卜抽卡</span>
            </button>
            <button
              onClick={() => setActiveTab('compendium')}
              className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm tracking-wider transition-all ${
                activeTab === 'compendium'
                  ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium shadow-[0_0_15px_rgba(200,169,110,0.3)]'
                  : 'text-[#B8B2A6] hover:text-[#F4F0EA]'
              }`}
            >
              <BookOpen className="w-3.5 h-3.5" />
              <span>六十四卦圖鑑</span>
            </button>
            <button
              onClick={() => setActiveTab('history')}
              className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm tracking-wider transition-all relative ${
                activeTab === 'history'
                  ? 'bg-[#C8A96E] text-[#0D0D0F] font-medium shadow-[0_0_15px_rgba(200,169,110,0.3)]'
                  : 'text-[#B8B2A6] hover:text-[#F4F0EA]'
              }`}
            >
              <History className="w-3.5 h-3.5" />
              <span>問卜紀錄</span>
              {history.length > 0 && (
                <span
                  className={`ml-0.5 px-1.5 py-0.2 rounded-full text-[10px] ${
                    activeTab === 'history'
                      ? 'bg-[#0D0D0F] text-[#C8A96E]'
                      : 'bg-[#C8A96E]/20 text-[#C8A96E]'
                  }`}
                >
                  {history.length}
                </span>
              )}
            </button>
          </nav>
        </div>
      </header>

      {/* 頂部浮動 Toast 提示 */}
      {toastMsg && (
        <div className="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 bg-[#1B1B22] border border-[#C8A96E]/60 text-[#F4F0EA] px-4 py-3 rounded-xl shadow-2xl animate-fade-in">
          <Check className="w-4 h-4 text-[#C8A96E] shrink-0" />
          <span className="text-sm tracking-wide">{toastMsg}</span>
        </div>
      )}

      {/* 主要內容區 */}
      <main className="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
        {/* ================================================================
            視圖一：問卜抽卡 (STEP 1 ~ STEP 4)
           ================================================================ */}
        {activeTab === 'oracle' && (
          <div className="space-y-8">
            {/* 步驟進度指示器 */}
            <div className="max-w-xl mx-auto flex items-center justify-between text-xs tracking-widest text-[#B8B2A6]">
              <div
                className={`flex items-center gap-2 ${
                  step >= 1 ? 'text-[#C8A96E]' : ' opacity-50'
                }`}
              >
                <span className="w-5 h-5 rounded-full border border-current flex items-center justify-center font-mono text-[11px]">
                  1
                </span>
                <span>立意提問</span>
              </div>
              <div className="flex-1 h-[1px] bg-gradient-to-r from-[#C8A96E]/40 to-[#C8A96E]/10 mx-3" />
              <div
                className={`flex items-center gap-2 ${
                  step >= 2 ? 'text-[#C8A96E]' : 'opacity-50'
                }`}
              >
                <span className="w-5 h-5 rounded-full border border-current flex items-center justify-center font-mono text-[11px]">
                  2
                </span>
                <span>靜心抽卦</span>
              </div>
              <div className="flex-1 h-[1px] bg-gradient-to-r from-[#C8A96E]/40 to-[#C8A96E]/10 mx-3" />
              <div
                className={`flex items-center gap-2 ${
                  step >= 3 ? 'text-[#C8A96E]' : 'opacity-50'
                }`}
              >
                <span className="w-5 h-5 rounded-full border border-current flex items-center justify-center font-mono text-[11px]">
                  3
                </span>
                <span>觀象解卦</span>
              </div>
            </div>

            {/* ------------------------------------------------------------
                STEP 1｜輸入問題
               ------------------------------------------------------------ */}
            {step === 1 && (
              <div className="max-w-2xl mx-auto">
                <div className="relative rounded-2xl bg-[#141418] border border-[#C8A96E]/25 p-6 sm:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.65)] overflow-hidden">
                  {/* 背景古典幾何浮水印 */}
                  <div className="absolute -top-12 -right-12 text-[#C8A96E]/10 pointer-events-none">
                    <BaguaOrnamentSVG className="w-56 h-56" />
                  </div>

                  {/* 主副標題 */}
                  <div className="text-center space-y-3 mb-8 relative z-10">
                    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8A96E]/10 border border-[#C8A96E]/30 text-[#D4B886] text-xs tracking-[0.2em]">
                      <span>周易本經六十四卦・啟發式神諭卡</span>
                    </div>
                    <h1 className="text-3xl sm:text-4xl font-serif tracking-[0.22em] text-[#F4F0EA] pt-1">
                      易經六十四卦
                    </h1>
                    <p className="text-sm sm:text-base text-[#B8B2A6] tracking-[0.15em] font-serif">
                      「一卦一問，照見當下的選擇」
                    </p>
                  </div>

                  {/* 問題輸入表單 */}
                  <form onSubmit={handleProceedToDraw} className="space-y-6 relative z-10">
                    <div>
                      <label
                        htmlFor="oracle-question"
                        className="block text-xs tracking-widest text-[#D4B886] uppercase mb-2.5"
                      >
                        請在心中默念並輸入您想釐清的處境或抉擇（必填）
                      </label>
                      <textarea
                        id="oracle-question"
                        rows={3}
                        value={question}
                        onChange={(e) => {
                          setQuestion(e.target.value);
                          if (questionError) setQuestionError('');
                        }}
                        placeholder="例如：我目前適合創業嗎？／這段關係接下來該如何相處？／我應該轉換工作方向嗎？"
                        className="w-full rounded-xl bg-[#0D0D0F]/90 border border-[#C8A96E]/30 focus:border-[#C8A96E] focus:outline-none p-4 text-base text-[#F4F0EA] placeholder-[#B8B2A6]/40 leading-relaxed transition-colors resize-none"
                      />
                      {questionError && (
                        <p className="mt-2 text-xs text-amber-400 flex items-center gap-1.5">
                          <AlertCircle className="w-3.5 h-3.5 shrink-0" />
                          <span>{questionError}</span>
                        </p>
                      )}
                    </div>

                    {/* 常見提問範例按鈕 */}
                    <div className="space-y-2">
                      <span className="text-xs text-[#B8B2A6]/80 tracking-wider block">
                        或點擊下方靈感範例：
                      </span>
                      <div className="flex flex-wrap gap-2">
                        {PRESET_QUESTIONS.map((preset) => (
                          <button
                            type="button"
                            key={preset}
                            onClick={() => {
                              setQuestion(preset);
                              setQuestionError('');
                            }}
                            className="text-left text-xs px-3 py-1.5 rounded-lg bg-[#0D0D0F] border border-[#C8A96E]/20 text-[#B8B2A6] hover:text-[#F4F0EA] hover:border-[#C8A96E]/50 transition-all"
                          >
                            {preset}
                          </button>
                        ))}
                      </div>
                    </div>

                    {/* 開始抽卡主按鈕 */}
