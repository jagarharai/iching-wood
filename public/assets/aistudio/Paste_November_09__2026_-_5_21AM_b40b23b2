/**
 * 使用 window.crypto.getRandomValues 搭配拒絕取樣 (Rejection Sampling)
 * 消除模數偏差 (Modulo Bias)，確保 0 ~ max-1 每個整數出現機率嚴格相等。
 */
export function getCryptoUniformRandomInt(max: number): number {
  if (max <= 0) throw new Error('max 必須為正整數');
  const array = new Uint32Array(1);
  const maxUint32 = 0xffffffff;
  const limit = maxUint32 - (maxUint32 % max);

  let randomValue = 0;
  do {
    window.crypto.getRandomValues(array);
    randomValue = array[0];
  } while (randomValue >= limit);

  return randomValue % max;
}

export function drawRandomHexagram(): Hexagram {
  const index = getCryptoUniformRandomInt(HEXAGRAMS.length);
  return HEXAGRAMS[index];
}

